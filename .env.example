# Copy to .env for local development. Do not use demo mode in production.
APP_ENV=development
DEMO_MODE=true
DATABASE_URL=sqlite:///./data/forensics_dev.db
EVIDENCE_STORAGE_DIR=./data/evidence
SESSION_COOKIE_NAME=dfi_session
SESSION_EXPIRE_MINUTES=60
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
CSRF_COOKIE_NAME=dfi_csrf
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
